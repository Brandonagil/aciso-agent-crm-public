# Use a Google Cloud project and credentials you control.
GOOGLE_CLOUD_PROJECT=example-project
VERTEXAI_PROJECT=example-project
VERTEXAI_LOCATION=us-central1
# Omit this variable to use Application Default Credentials.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside-repository/service-account.json

BQ_PROJECT_ID=example-project
BQ_DATASET_ID=churn_prevention
BQ_TABLE_NAME=mitglieder
# Optional full model paths; defaults are built from project and dataset.
BQML_MODEL_PATH=
BQML_EXPLAIN_MODEL_PATH=
# Full resource name of your own Vertex AI RAG corpus.
VERTEXAI_RAG_CORPUS=

ADK_DEBUG=false
LOG_LEVEL=INFO
PORT=8001
